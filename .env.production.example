# Optional Custom Host & Cookie Overrides (If omitted, app auto-detects HTTPS in production)
APP_BASE_URL="https://vault.yourdomain.com"
COOKIE_SECURE="true"     # Enforces HTTPS cookies in production
COOKIE_SAME_SITE="strict"# Strict CSRF protection
COOKIE_HTTP_ONLY="true"

# Optional Security Timeouts & Policies (Defaults apply if omitted)
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION_MINUTES="15"
SESSION_IDLE_TIMEOUT_MINUTES="30"
LOG_RETENTION_HOURS="72"
HSTS_MAX_AGE="31536000"
ENABLE_CSP="true"

# Optional Upstash Redis Edge Caching/Rate-Limiting (LEAVE BLANK if not using Redis)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Optional Resend Email Alerts (LEAVE BLANK if not sending security emails)
# RESEND_API_KEY=""
# ALERT_EMAIL_TO=""
# ALERT_EMAIL_FROM=""
