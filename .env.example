# ==============================================================================
# SHAREAPP — EXAMPLE ENVIRONMENT (.env.example)
# Use this as a template to create your own .env.local or .env.production file.
# Replace the dummy values below with your actual settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔴 SECTION A: MANDATORY VARIABLES (REQUIRED FOR APP TO RUN)
# ------------------------------------------------------------------------------

# 1. Application Name & Environment Mode
APP_NAME="ShareApp Vault (Demo)"
NODE_ENV="development"

# 2. Account Login Identity & Master Password
OWNER_EMAIL="demo@example.com"
ADMIN_PASSWORD="your_secure_password"

# 3. Cryptographic Field Encryption Key (64 hex characters)
ENCRYPTION_KEY="your_64_character_hex_encryption_key_here"

# 4. JWT Authentication Secrets (Min 32 characters)
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# 5. Database Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI="mongodb://localhost:27017/your-database"


# ------------------------------------------------------------------------------
# 🟢 SECTION B: OPTIONAL VARIABLES (CAN BE BLANK / OMITTED)
# ------------------------------------------------------------------------------

# Optional 2FA TOTP (Leave blank for 1-step password login)
TOTP_SECRET=""
TOTP_RECOVERY_CODES=""

# Optional Custom Host & Cookie Overrides
PORT="3000"
APP_BASE_URL="http://localhost:3000"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
COOKIE_HTTP_ONLY="true"

# Optional Security Timeouts & Policies
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION_MINUTES="15"
SESSION_IDLE_TIMEOUT_MINUTES="2880"
LOG_RETENTION_HOURS="72"
HSTS_MAX_AGE="63072000"
ENABLE_CSP="true"
